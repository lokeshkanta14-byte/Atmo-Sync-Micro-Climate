    "Spoilage_Risk_%",

    CASE
        WHEN "Spoilage_Risk_%" >= 70 THEN 'HIGH'
        WHEN "Spoilage_Risk_%" >= 40 THEN 'MEDIUM'
        ELSE 'LOW'
    END AS RISK_CATEGORY

FROM IOT_PROJECT.PUBLIC.stg_raw_iot_data

WHERE RECORD_ID IS NOT NULL
