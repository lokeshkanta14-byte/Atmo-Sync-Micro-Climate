    as (

WITH ranked_data AS (

    SELECT
        *,
        ROW_NUMBER() OVER (
            PARTITION BY RECORD_ID
            ORDER BY RECORD_ID
        ) AS rn

    FROM IOT_PROJECT.PUBLIC.stg_raw_iot_data

)

SELECT

    RECORD_ID,
    TIMESTAMP,
    CONTAINER_ID,
    SHIPMENT_ID,
    PRODUCT_NAME,
    ORIGIN_CITY,
    DESTINATION_CITY,

    COALESCE(TEMPERATURE_C,
        AVG(TEMPERATURE_C) OVER()) AS TEMPERATURE_C,

    COALESCE(HUMIDITY_PERCENT,
        AVG(HUMIDITY_PERCENT) OVER()) AS HUMIDITY_PERCENT,

    COALESCE(VIBRATION_LEVEL,
        AVG(VIBRATION_LEVEL) OVER()) AS VIBRATION_LEVEL,

    COALESCE(MARKET_PRICE_PER_KG,
        AVG(MARKET_PRICE_PER_KG) OVER()) AS MARKET_PRICE_PER_KG,

    COALESCE(SPOILAGE_RISK,
        AVG(SPOILAGE_RISK) OVER()) AS SPOILAGE_RISK,

    COALESCE(DISTANCE_TO_MARKET,
        AVG(DISTANCE_TO_MARKET) OVER()) AS DISTANCE_TO_MARKET,

    COALESCE(TIME_TO_SPOILAGE_HOURS,
        AVG(TIME_TO_SPOILAGE_HOURS) OVER()) AS TIME_TO_SPOILAGE_HOURS,

    SHELF_LIFE_REMAINING_HOURS,

    QUALITY_SCORE,

    PRODUCT_WEIGHT_KG,

    ESTIMATED_REVENUE,

    ESTIMATED_LOSS,

    ARBITRAGE_PROFIT,

    RECOMMENDED_ACTION,

    ALERT_LEVEL,

    CASE
        WHEN SPOILAGE_RISK >= 70 THEN 'HIGH'
        WHEN SPOILAGE_RISK >= 40 THEN 'MEDIUM'
        ELSE 'LOW'
    END AS RISK_CATEGORY

FROM ranked_data

WHERE rn = 1
AND RECORD_ID IS NOT NULL
    )

